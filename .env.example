# FORGE — environment variable reference for local development.
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# ── GitHub App credentials ────────────────────────────────────────────────────
# Numeric App ID shown on the GitHub App settings page
FORGE_APP_ID=

# Client ID shown on the GitHub App settings page (separate from App ID)
# Stored as a repo variable (not secret) — publicly visible on the settings page
FORGE_APP_CLIENT_ID=

# Contents of the .pem private key file downloaded when the App was created
# In CI this is stored as a multiline secret; locally paste the full PEM content
FORGE_APP_PRIVATE_KEY=

# GitHub owner (user or org) where forge-demo-apps lives
FORGE_GITHUB_OWNER=Flamespiker

# The target application monorepo the GitHub App is installed on
FORGE_TARGET_REPO=forge-demo-apps

# ── Azure DevOps ──────────────────────────────────────────────────────────────
# Personal Access Token with Work Items (R/W) and Project (R) scopes
ADO_PAT=

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Your Anthropic API key — must have Managed Agents beta access for Stage 3
ANTHROPIC_API_KEY=
