# FORGE — environment variable reference for local development.
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# ── GitHub App credentials ────────────────────────────────────────────────────
# Numeric App ID shown on the GitHub App settings page
FORGE_APP_ID=

# Client ID shown on the GitHub App settings page (separate from App ID)
# Stored as a repo variable (not secret) — publicly visible on the settings page
FORGE_APP_CLIENT_ID=

# Contents of the .pem private key file downloaded when the App was created
# In CI this is stored as a multiline secret; locally paste the full PEM content
FORGE_APP_PRIVATE_KEY=

# GitHub owner (user or org) where both repos live
FORGE_GITHUB_OWNER=Flamespiker

# Where the GitHub App operates — the application monorepo (cross-repo ops).
# create_branch, commit_files, open_pr all target this repo via the App installation token.
FORGE_TARGET_REPO=forge-demo-apps

# Where the tracking issue lives — the orchestration repo itself (same-repo ops).
# post_comment, add_label, remove_label target this repo via GITHUB_TOKEN, not the App.
# The App is not installed here; it operates cross-repo into FORGE_TARGET_REPO only.
# Override only if the repo is renamed — default is forge-template.
FORGE_SOURCE_REPO=forge-template

# LOCAL DEV ONLY — do NOT add this as a GitHub Actions secret.
# In Actions, the runtime automatically injects GITHUB_TOKEN as an ephemeral, run-scoped
# token for the workflow's own repo (forge-template). No secret configuration is needed.
# Locally: create a fine-grained PAT limited to forge-template, Issues: Read and write.
# That narrow scope is all post_comment and add_label require.
GITHUB_TOKEN=

# ── Azure DevOps ──────────────────────────────────────────────────────────────
# Personal Access Token with Work Items (R/W) and Project (R) scopes
ADO_PAT=

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Your Anthropic API key — must have Managed Agents beta access for Stage 3
ANTHROPIC_API_KEY=

# ── Azure Container Registry (Deploy Agent, Step 3.10) ────────────────────────
# ACR admin-user credentials — build-phase acceptable (Document 3 §9's usual
# graduation path is a scoped service principal with AcrPush before production).
ACR_LOGIN_SERVER=
ACR_USERNAME=
ACR_PASSWORD=

# ── Azure Container Apps staging deploy (Deploy Agent, Step 3.10) ─────────────
# One JSON blob: clientId/clientSecret/subscriptionId/tenantId for the
# forge-deploy-staging service principal (Contributor on the resource group
# containing forge-staging — see team/config.yaml's container_apps.staging).
# In .env, wrap the whole value in single quotes so the JSON's own double
# quotes survive: AZURE_STAGING_CREDENTIALS='{"clientId":"...","clientSecret":"...","subscriptionId":"...","tenantId":"..."}'
AZURE_STAGING_CREDENTIALS=
