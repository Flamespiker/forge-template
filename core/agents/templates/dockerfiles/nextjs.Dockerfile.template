# FORGE-generated Dockerfile — Next.js frontend.
# Generated by core/agents/deploy_agent.py from nextjs.Dockerfile.template.
# Only generated when the frontend/ directory has no Dockerfile of its own.
#
# Build context is the frontend/ directory itself. Build with:
#   docker build -f Dockerfile -t <tag> <frontend-dir>
#
# Assumes a standard (non-"output: standalone") Next.js build — `npm run
# start` (next start) serves the .next build output and needs the full
# node_modules tree alongside it. If the team's next.config switches to
# `output: "standalone"`, this template should be revisited to copy only
# .next/standalone + .next/static + public instead.

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 3000
ENV PORT=3000

CMD ["npm", "run", "start"]
