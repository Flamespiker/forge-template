FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

{{BUILD_PROPS_COPY_LINE}}COPY ["{{PROJECT_DIR}}/{{CSPROJ_NAME}}", "{{PROJECT_DIR}}/"]
RUN dotnet restore "{{PROJECT_DIR}}/{{CSPROJ_NAME}}"

COPY . .

WORKDIR "/src/{{PROJECT_DIR}}"
RUN dotnet build "{{CSPROJ_NAME}}" -c Release -o /app/build --no-restore

FROM build AS publish
RUN dotnet publish "{{CSPROJ_NAME}}" -c Release -o /app/publish /p:UseAppHost=false --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final

# Run as non-root user for security
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
WORKDIR /app

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

COPY --from=publish /app/publish .
RUN chown -R appuser:appgroup /app

USER appuser

ENTRYPOINT ["dotnet", "{{ASSEMBLY_NAME}}.dll"]
